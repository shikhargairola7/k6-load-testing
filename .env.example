# Copy to .env and fill in real sandbox values. .env is git-ignored.
# All values below are FAKE placeholders.

# ---------------------------- Global ----------------------------
BASE_URL=https://sandbox.api.vikexpress.com
TOKEN_PATH=/rest-api/profile-access/token
QUERY_PATH=/rest-api/wallet/report/routing-number/query

# How many users to simulate (each user = 1 VU / thread).
USERS=1
# Cycles each user runs, sequentially.
CYCLES_PER_USER=100

# Token response field that holds the access token. Dot-path allowed,
# e.g. data.access_token
TOKEN_JSON_PATH=access_token

# How credentials are sent on the token request:
#   basic -> Authorization: Basic base64(username:password)   (default)
#   none  -> no credentials (username/password not required)
#   body  -> username/password added into the JSON payload
TOKEN_AUTH_MODE=basic

# false -> fresh token every cycle (default, matches the spec).
# true  -> generate one token per user and reuse it for all cycles.
TOKEN_REUSE=false

# "source" field in the token payload. Empty by default (matches the current
# request); set to web for the older behavior.
TOKEN_SOURCE=

# Permissions requested in the token payload (comma-separated).
PERMISSIONS=view_history,view_wallet,send_to_account,withdraw_from_account,send_cash

# Routing number source for the query call:
#   random     -> uniform random pick from ROUTING_NUMBERS_FILE each cycle (default)
#   sequential -> walk the file in order, wrapping around
#   per-user   -> ignore the file, use USER<n>_ROUTING_NUMBER
ROUTING_STRATEGY=random
# CSV file, path relative to load-test.js. Header optional; the last all-digits
# column of each line is used (so "ID,Routing Number" works).
ROUTING_NUMBERS_FILE=./routing_numbers.csv

# Per-request timeout and optional pause between cycles (seconds).
HTTP_TIMEOUT=60s
SLEEP_BETWEEN_CYCLES=0

# ------------------ Per-request detail log ---------------------
# One row per HTTP request -> results/requests-<runId>.csv, columns:
#   index,userId,environment,api,requestUrl,requestBody,status,ok,
#   responseTimeMs,timestamp,errorMessage,responseBody
# Emitted as base64 console lines during the run and decoded by run.ps1 / run.sh.
# Credentials are masked; token response bodies are redacted.
REQUEST_LOG=true
# Max characters kept from request/response bodies (0 = store none).
RESPONSE_BODY_MAX=500
# Also fold the rows into results/summary-*.json (run.ps1 only).
EMBED_REQUESTS_IN_JSON=true
# Append the full run summary (totals, latency table, thresholds) to the bottom
# of results/requests-*.csv so it's all in one sheet.
APPEND_SUMMARY_CSV=true
# Also write results/run-summary-*.csv (one flat row per run). Turn on only when
# comparing several runs (1u vs 3u vs 5u ...).
RUN_SUMMARY_CSV=false
# Value for the "environment" column (default: first label of the BASE_URL host).
#ENV_LABEL=sandbox

# ------------------------ Thresholds (ms / rate) ----------------
THRESH_CYCLE_P95=2000
THRESH_CYCLE_P99=5000
THRESH_TOKEN_P95=1000
THRESH_QUERY_P95=1000
THRESH_ERROR_RATE=0.01

# ---------------------------- User 1 ----------------------------
# USER<n>_ROUTING_NUMBER is only used when ROUTING_STRATEGY=per-user.
USER1_UID=wingcash:0000000001
USER1_MANAGER_UID=wingcash:0000000002
USER1_USERNAME=replace-me
USER1_PASSWORD=replace-me
USER1_ROUTING_NUMBER=000000000

# ------------------- User 2 (needed when USERS>=2) --------------
#USER2_UID=wingcash:0000000003
#USER2_MANAGER_UID=wingcash:0000000004
#USER2_USERNAME=replace-me
#USER2_PASSWORD=replace-me
#USER2_ROUTING_NUMBER=000000000

